# Copie para .env no servidor (nunca versione o .env).

# Versão da imagem em execução (gerenciada pelo atualizador; formato X.Y.Z sem "v")
CASA_NOVA_TAG=0.1.0
# IP onde a porta fica exposta: use o IP da LAN ou do Tailscale para acesso só privado
CASA_NOVA_BIND=192.168.1.90
CASA_NOVA_PORT=3010

# Senha de acesso. Prefira o hash:  echo -n 'sua-senha' | docker exec -i casa-nova node_modules/.bin/tsx server/cli.ts hash-password
APP_PASSWORD_HASH=
# APP_PASSWORD=   (alternativa em texto, mínimo 8 caracteres)

# true somente se servir por HTTPS
COOKIE_SECURE=false

# Bot EXCLUSIVO do Casa Nova criado no @BotFather (não reutilize o bot do Hermes: getUpdates conflita)
TELEGRAM_BOT_TOKEN=
# Opcional: fixa o chat (senão, vincule pela tela Configurações → Telegram)
TELEGRAM_CHAT_ID=

# Quantos backups diários manter
BACKUP_KEEP=14
